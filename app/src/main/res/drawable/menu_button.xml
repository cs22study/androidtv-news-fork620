<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/menu_item_focused_start"
                android:endColor="@color/menu_item_focused_end"
                android:angle="0" />
            <corners android:radius="8dp" />
            <stroke
                android:width="2dp"
                android:color="#90CAF9" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1565C0" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_item_bg" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#242B38" />
        </shape>
    </item>
</selector>
